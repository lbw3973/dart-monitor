# cp .env.example .env 후 실제 키 입력
DART_API_KEY=your_40_char_opendart_key_here

# 카카오 OAuth (서버 전용 — 브라우저로 절대 내려보내지 않음)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback

# GA4 측정 ID (방문 통계, 선택)
# analytics.google.com → 관리 → 데이터 스트림 → 웹 스트림 → 측정 ID
# 페이지에 노출되는 공개 식별자다. 비워두면 통계 수집 코드가 아예 로드되지 않는다.
VITE_GA_ID=
