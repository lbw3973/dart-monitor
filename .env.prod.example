# 운영 서버용 — cp .env.prod.example .env 후 실제 값 입력
DOMAIN=dart.example.com

# 레지스트리 이미지 (Makefile의 IMAGE_NAME과 동일하게)
# 버전 태그는 여기 적지 않는다 — update.sh 실행 시 지정한다.
IMAGE_NAME=ghcr.io/lbw3973/dart

POSTGRES_PASSWORD=       # openssl rand -base64 24

DART_API_KEY=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=     # 콘솔에서 비활성화했다면 비워둠
