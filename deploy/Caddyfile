# {$DOMAIN} 은 docker-compose의 환경변수로 주입된다.
# Caddy가 Let's Encrypt 인증서를 자동 발급·갱신한다.
{$DOMAIN} {
	encode gzip

	# 운영 배치(소급 수집·재파싱)는 인터넷에 노출하지 않는다.
	# 한 번에 수 분씩 돌면서 DART API를 두드리는 작업이라 열어 둘 이유가 없다.
	# 필요할 때는 서버 안에서 호출한다 (§deploy/update-data.sh):
	#   docker compose exec backend wget -qO- --post-data='' \
	#     'http://localhost:8080/api/ops/reparse?status=FAILED'
	handle /api/ops/* {
		respond 404
	}

	# 관리자 화면(/api/admin/*)은 브라우저가 호출하므로 통과시킨다.
	# 인증은 백엔드의 AdminGuard 가 맡는다 — 로그인 없으면 401, 관리자 아니면 403.

	# SSE는 버퍼링하면 안 된다
	handle /api/stream {
		reverse_proxy backend:8080 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /actuator/* {
		respond 404
	}

	# SPA — 정적 파일이 없으면 index.html로 폴백
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
